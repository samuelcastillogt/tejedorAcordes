# ChordWeaver app — copy to `.env.local` for local development. EAS builds take these values
# from eas.json (they are public: they identify the Firebase project, they do not grant access).
EXPO_PUBLIC_API_URL=https://chords-api-python.vercel.app
EXPO_PUBLIC_WEB_URL=https://samuelcastillogt.github.io/chordsAppWeb
# Firebase console > Project settings > Your apps > Web app (same project as the website).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
